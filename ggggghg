async def handle_join_request(update: ChatJoinRequest, bot: Bot):
    if await get_setting("antiraid", "on") != "on":
        return
    
    user = update.from_user
    chat_id = update.chat.id
    
    # Причины для отклонения
    reason = None
    
    # 1. Нет юзернейма (типичный бот-пустышка)
    if not user.username:
        reason = "нет юзернейма (@username)"
        
    # 2. Нет аватарки (боты/пустышки)
    elif not user.photo:
        reason = "нет аватарки"
        
    # 3. Аккаунт создан слишком недавно
    else:
        # В Telegram ID пользователей растут со временем. 
        # Примерно можно прикинуть, но лучше запрашивать инфу.
        # Мы используем простой хак: ID > 7_000_000_000 обычно свежие (2023+)
        # Но чтобы точно, проверяем статус через API невозможно без доп. библиотек.
        # Поэтому используем проверку по ID как грубый фильтр.
        pass

    if reason:
        try:
            await bot.decline_chat_join_request(chat_id, user.id)
            await inc_stat("join_requests_declined")
            await _notify_admins(
                bot,
                f"🛡 <b>Заявка отклонена</b>\n"
                f"Чат: <code>{chat_id}</code>\n"
                f"Юзер: {user.full_name} (ID: <code>{user.id}</code>)\n"
                f"Причина: {reason}"
            )
        except Exception as e:
            logging.error(f"Ошибка отклонения заявки: {e}")
    else:
        # Если всё ок — одобряем
        try:
            await bot.approve_chat_join_request(chat_id, user.id)
            await inc_stat("join_requests_approved")
        except Exception as e:
            logging.error(f"Ошибка одобрения заявки: {e}")


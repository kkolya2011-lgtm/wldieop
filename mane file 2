admin_router = Router()

def panel_kb(on: bool):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=f"🛡 Антирейд: {'ВКЛ ✅' if on else 'ВЫКЛ ❌'}", callback_data="panel:toggle")],
        [InlineKeyboardButton(text="📊 Статистика", callback_data="panel:stats")],
        [InlineKeyboardButton(text="👥 Админы бота", callback_data="panel:admins")],
        [InlineKeyboardButton(text="ℹ️ Помощь", callback_data="panel:help")],
    ])

@admin_router.message(Command("panel"))
async def cmd_panel(msg: Message):
    if not await is_admin(msg.from_user.id):
        return
    s = await get_setting("antiraid", "on")
    await msg.answer("🛡 <b>Админ-панель антирейд-бота</b>", reply_markup=panel_kb(s == "on"), parse_mode="HTML")

@admin_router.callback_query(F.data.startswith("panel:"))
async def cb_panel(cb: CallbackQuery, bot: Bot):
    if not await is_admin(cb.from_user.id):
        await cb.answer("Нет доступа", show_alert=True)
        return
    a = cb.data.split(":", 1)[1]
    if a == "toggle":
        s = await get_setting("antiraid", "on")
        new = "off" if s == "on" else "on"
        await set_setting("antiraid", new)
        await cb.message.edit_reply_markup(reply_markup=panel_kb(new == "on"))
        await cb.answer(f"Антирейд: {'ВКЛ' if new == 'on' else 'ВЫКЛ'}")
    elif a == "stats":
        st = await get_stats()
        await cb.message.answer(
            "📊 <b>Статистика</b>\n\n"
            f"Рейдов по входам: {st.get('join_raids', 0)}\n"
            f"Мутов в чатах: {st.get('chat_mutes', 0)}\n"
            f"Рейдов в каналах: {st.get('channel_raids', 0)}\n"
            f"Капча пройдена: {st.get('captcha_passed', 0)}\n"
            f"Кикнуто по капче: {st.get('captcha_kicks', 0)}\n"
            f"Заявок отклонено: {st.get('join_requests_declined', 0)}\n"
            f"Заявок одобрено: {st.get('join_requests_approved', 0)}",
            parse_mode="HTML")
        await cb.answer()
    elif a == "admins":
        admins = await list_admins()
        lines = [f"<code>{uid}</code>" for uid, _ in admins] or ["пусто"]
        await cb.message.answer(
            "👥 <b>Админы бота:</b>\n" + "\n".join(lines) +
            f"\n\nВладелец: <code>{OWNER_ID}</code>", parse_mode="HTML")
        await cb.answer()
    elif a == "help":
        await cb.message.answer(
            f"@{BOT_USERNAME}\n\n/panel — панель\n/grant (reply) — выдать админку бота\n/revoke (reply) — забрать (только владелец)\n\n"
            "Бот работает во всех чатах. Заявки без аватарки/юзернейма отклоняются.", parse_mode="HTML")
        await cb.answer()

@admin_router.message(Command("grant"))
async def cmd_grant(msg: Message):
    if not await is_admin(msg.from_user.id):
        return
    if not msg.reply_to_message:
        await msg.reply("Ответь на сообщение пользователя.")
        return
    t = msg.reply_to_message.from_user
    await add_admin(t.id)
    await msg.reply(f"✅ @{t.username or t.id} теперь админ бота.")

@admin_router.message(Command("revoke"))
async def cmd_revoke(msg: Message):
    if msg.from_user.id != OWNER_ID:
        await msg.reply("Только владелец может забирать админку.")
        return
    if not msg.reply_to_message:
        await msg.reply("Ответь на сообщение пользователя.")
        return
    t = msg.reply_to_message.from_user
    if t.id == OWNER_ID:
        await msg.reply("Нельзя забрать у владельца.")
        return
    await remove_admin(t.id)
    await msg.reply("✅ Админка забрана.")

# ==================== MAIN ====================
async def main():
    bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    dp = Dispatcher()

    @dp.message(CommandStart())
    async def start(msg: Message):
        await msg.answer("Привет! Добавь меня админом в чат и открой /panel.")

    @dp.callback_query(F.data.startswith("cap:"))
    async def cap_cb(cb: CallbackQuery, bot: Bot):
        await handle_captcha_callback(cb, bot)

    dp.include_router(admin_router)

    @dp.chat_join_request()
    async def join_req(update: ChatJoinRequest, bot: Bot):
        await handle_join_request(update, bot)

    @dp.message(F.new_chat_members)
    async def new_members(msg: Message, bot: Bot):
        await handle_new_members(msg, bot)

    @dp.message()
    async def any_msg(msg: Message, bot: Bot):
        await handle_message(msg, bot)

    await bot.delete_webhook(drop_pending_updates=True)
    logging.info("Бот запущен")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())

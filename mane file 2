# Вместо базы данных
admins_db = {OWNER_ID}  # Множество ID админов бота. Владелец добавлен по умолчанию.
settings = {"antiraid": "on"}
stats = defaultdict(int)

async def add_admin(user_id):
    admins_db.add(user_id)

async def remove_admin(user_id):
    admins_db.discard(user_id)

async def is_admin(user_id):
    return user_id in admins_db

async def list_admins():
    return [(uid, "") for uid in admins_db]

async def get_setting(key, default="on"):
    return settings.get(key, default)

async def set_setting(key, value):
    settings[key] = value

async def inc_stat(key, amount=1):
    stats[key] += amount

async def get_stats():
    return dict(stats)

# ==================== КАПЧА ====================
pending_captcha = {}
captcha_tasks = {}

def generate_example():
    kind = random.choice(["add", "sub", "mul", "div", "mix"])
    if kind == "add":
        a, b = random.randint(2, 30), random.randint(2, 30)
        return f"{a} + {b}", a + b
    if kind == "sub":
        a, b = random.randint(10, 40), random.randint(1, 9)
        return f"{a} − {b}", a - b
    if kind == "mul":
        a, b = random.randint(2, 9), random.randint(2, 9)
        return f"{a} × {b}", a * b
    if kind == "div":
        b, res = random.randint(2, 9), random.randint(2, 9)
        return f"{b*res} ÷ {b}", res
    a, b, c = random.randint(1, 10), random.randint(2, 5), random.randint(2, 5)
    return f"{a} + {b} × {c}", a + b * c

def build_captcha_kb(correct):
    options = {correct}
    while len(options) < 4:
        cand = correct + random.randint(1, 15) * random.choice([-1, 1])
        if cand >= 0:
            options.add(cand)
    options = list(options)
    random.shuffle(options)
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=str(o), callback_data=f"cap:{o}")] for o in options
    ])

async def send_captcha(bot: Bot, chat_id: int, user_id: int, user_name: str):
    text, answer = generate_example()
    pending_captcha[user_id] = answer
    kb = build_captcha_kb(answer)
    msg = await bot.send_message(
        chat_id,
        f"👋 {user_name}, реши пример, чтобы писать в чат:\n\n<b>{text} = ?</b>\n\n⏳ У тебя {CAPTCHA_TIMEOUT} сек.",
        reply_markup=kb, parse_mode="HTML")

    async def kick_later():
        await asyncio.sleep(CAPTCHA_TIMEOUT)
        if user_id in pending_captcha:
            pending_captcha.pop(user_id, None)
            try:
                await bot.ban_chat_member(chat_id, user_id)
                await bot.unban_chat_member(chat_id, user_id)
                await msg.delete()
                await inc_stat("captcha_kicks")
            except Exception:
                pass

    captcha_tasks[user_id] = asyncio.create_task(kick_later())

async def handle_captcha_callback(callback: CallbackQuery, bot: Bot):
    user_id = callback.from_user.id
    if user_id not in pending_captcha:
        await callback.answer("Капча неактивна.", show_alert=True)
        return
    correct = pending_captcha[user_id]
    try:
        chosen = int(callback.data.split(":")[1])
    except ValueError:
        return
    if chosen == correct:
        pending_captcha.pop(user_id, None)
        t = captcha_tasks.pop(user_id, None)
        if t:
            t.cancel()
        try:
            await callback.message.delete()
        except Exception:
            pass
        await callback.answer("✅ Верно! Добро пожаловать.")
        await inc_stat("captcha_passed")
    else:
        await callback.answer("❌ Неверно, попробуй ещё.", show_alert=True)

# ==================== АНТИРЕЙД ====================
join_events = defaultdict(deque)
msg_events = defaultdict(deque)
raid_mode = {}

def _prune(dq, window, now):
    while dq and now - dq[0][0] > window:
        dq.popleft()

async def _notify_admins(bot: Bot, text: str):
    for uid in list(admins_db):
        try:
            await bot.send_message(uid, text, parse_mode="HTML")
        except Exception:
            pass

async def handle_new_members(message: Message, bot: Bot):
    if await get_setting("antiraid", "on") != "on":
        return
    chat_id = message.chat.id
    priority = chat_id in PRIORITY_CHATS
    limit = JOIN_RAID_LIMIT if priority else SOFT_JOIN_LIMIT
    window = JOIN_RAID_WINDOW if priority else SOFT_JOIN_WINDOW

    now = time.time()
    dq = join_events[chat_id]

    for m in message.new_chat_members:
        if m.is_bot:
            continue
        dq.append((now, m.id))
        await send_captcha(bot, chat_id, m.id, m.full_name)

    _prune(dq, window, now)

    if len(dq) >= limit and chat_id not in raid_mode:
        raid_mode[chat_id] = now + 300
        await inc_stat("join_raids")
        cutoff = now - JOIN_RAID_KICK_RECENT
        recent = [uid for ts, uid in dq if ts >= cutoff]
        kicked = 0
        for uid in recent:
            try:
                await bot.ban_chat_member(chat_id, uid)
                await bot.unban_chat_member(chat_id, uid)
                kicked += 1
            except Exception:
                pass
        await _notify_admins(
            bot,
            f"🚨 <b>РЕЙД ПО ВХОДАМ</b>\nЧат: <code>{chat_id}</code>\n"
            f"{'⭐ приоритетный' if priority else 'обычный'}\n"
            f"Входов за {window}с: {len(recent)}\nКикнуто: {kicked}")

async def handle_message(message: Message, bot: Bot):
    if await get_setting("antiraid", "on") != "on":
        return
    if message.from_user is None or message.from_user.is_bot:
        return
    if await is_admin(message.from_user.id):
        return

    chat_id, user_id = message.chat.id, message.from_user.id
    priority = chat_id in PRIORITY_CHATS
    is_channel = message.chat.type == "channel"

    if is_channel:
        limit = MSG_LIMIT_CHANNEL if priority else SOFT_MSG_LIMIT_CHANNEL
    else:
        limit = MSG_LIMIT_CHAT if priority else SOFT_MSG_LIMIT_CHAT

    now = time.time()
    key = (chat_id, user_id)
    dq = msg_events[key]
    dq.append((now, None))
    _prune(dq, MSG_WINDOW, now)

    if len(dq) < limit:
        return

    msg_events[key].clear()
    mute = MUTE_DURATION if priority else SOFT_MUTE_DURATION

    if is_channel:
        try:
            await bot.delete_message(chat_id, message.message_id)
        except Exception:
            pass
        demoted = False
        try:
            await bot.promote_chat_member(
                chat_id, user_id,
                can_manage_chat=False, can_post_messages=False,
                can_edit_messages=False, can_delete_messages=False,
                can_manage_video_chats=False, can_restrict_members=False,
                can_promote_members=False, can_change_info=False,
                can_invite_users=False, can_pin_messages=False,
                can_manage_topics=False)
            demoted = True
        except Exception:
            pass
        await inc_stat("channel_raids")
        await _notify_admins(
            bot,
            f"🚨 <b>РЕЙД В КАНАЛЕ</b>\nКанал: <code>{chat_id}</code>\n"
            f"Юзер: <a href='tg://user?id={user_id}'>{message.from_user.full_name}</a>\n"
            f"Сообщений/мин: {limit}\nСнят с админки: {'да' if demoted else 'НЕ УДАЛОСЬ'}")
    else:
        try:
            await bot.restrict_chat_member(
                chat_id, user_id,
                until_date=int(now) + mute,
                can_send_messages=False)
            await inc_stat("chat_mutes")
            await _notify_admins(
                bot,
                f"🚨 <b>РЕЙД В ЧАТЕ</b>\nЧат: <code>{chat_id}</code>\n"
                f"Юзер: <a href='tg://user?id={user_id}'>{message.from_user.full_name}</a>\n"
                f"Мут: {mute//3600}ч (>{limit} сообщений/мин)")
        except Exception as e:
            await _notify_admins(bot, f"⚠️ Не смог замутить {user_id}: {e}")


async def handle_join_request(update: ChatJoinRequest, bot: Bot):
    if await get_setting("antiraid", "on") != "on":
        return
    
    user = update.from_user
    chat_id = update.chat.id
    reason = None
    
    if not user.username:
        reason = "нет юзернейма (@username)"
    elif not user.photo:
        reason = "нет аватарки"

    if reason:
        try:
            await bot.decline_chat_join_request(chat_id, user.id)
            await inc_stat("join_requests_declined")
            await _notify_admins(
                bot,
                f"🛡 <b>Заявка отклонена</b>\nЧат: <code>{chat_id}</code>\n"
                f"Юзер: {user.full_name} (ID: <code>{user.id}</code>)\nПричина: {reason}")
        except Exception as e:
            logging.error(f"Ошибка отклонения заявки: {e}")
    else:
        try:
            await bot.approve_chat_join_request(chat_id, user.id)
            await inc_stat("join_requests_approved")
        except Exception as e:
            logging.error(f"Ошибка одобрения заявки: {e}")

